APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list. Remove a name to disable that platform.
ENABLED_PLATFORMS=devto,bluesky,tumblr,gist,jsonplaceholder

# Seconds. REQUEST_TIMEOUT covers read/write, CONNECT_TIMEOUT covers opening the connection.
REQUEST_TIMEOUT=15
CONNECT_TIMEOUT=5

# Retries after the first attempt, for errors that are safe to retry.
MAX_RETRIES=2
# Optional per-platform overrides, for example: devto=3,tumblr=0
PLATFORM_MAX_RETRIES=

# DEV Community
DEVTO_BASE_URL=https://dev.to
DEVTO_API_KEY=

# Bluesky
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_WEB_URL=https://bsky.app
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Tumblr
TUMBLR_API_BASE_URL=https://api.tumblr.com/v2
TUMBLR_AUTHORIZE_URL=https://www.tumblr.com/oauth2/authorize
TUMBLR_TOKEN_URL=https://api.tumblr.com/v2/oauth2/token
TUMBLR_BLOG_IDENTIFIER=
TUMBLR_CONSUMER_KEY=
TUMBLR_SECRET_KEY=
TUMBLR_ACCESS_TOKEN=
# Must exactly match an OAuth2 redirect URL registered on https://www.tumblr.com/oauth/apps
TUMBLR_REDIRECT_URI=http://localhost:4000/tumblr/callback
# Where /tumblr/callback and token refreshes save the current tokens (git-ignored)
TUMBLR_TOKEN_STORE_PATH=.secrets/tumblr_tokens.json

# GitHub Gist
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_GIST_TOKEN=
# true creates a public gist, false a secret (unlisted) gist
GITHUB_GIST_PUBLIC=true

# JSONPlaceholder (no credentials needed)
JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com
JSONPLACEHOLDER_USER_ID=1
